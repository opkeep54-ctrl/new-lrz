<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LRZ Panel</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap');
        
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Cairo', sans-serif; }
        
        body { 
            background-color: #050505; 
            background-image: radial-gradient(circle at 50% 0%, #1a1a1a 0%, #050505 70%);
            color: #ffffff; 
            display: flex; 
            height: 100vh; 
            overflow: hidden; 
        }
        
        /* القائمة الجانبية */
        .sidebar { 
            width: 260px; 
            background: rgba(10, 10, 10, 0.95); 
            backdrop-filter: blur(10px);
            border-left: 1px solid #222; 
            display: flex; 
            flex-direction: column; 
            padding: 20px 0; 
            overflow-y: auto; 
            z-index: 10;
        }
        .logo { 
            font-size: 24px; font-weight: 900; text-align: center; padding-bottom: 20px; 
            border-bottom: 1px solid #222; margin-bottom: 20px; letter-spacing: 1px; 
            color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.3);
        }
        .nav-item { 
            padding: 16px 20px; cursor: pointer; transition: all 0.3s ease; 
            border-right: 3px solid transparent; color: #888; font-size: 16px; font-weight: 700;
        }
        .nav-item:hover { background: rgba(255, 255, 255, 0.05); color: #fff; padding-right: 25px; }
        .nav-item.active { 
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1)); 
            color: #fff; border-right: 4px solid #fff; box-shadow: -5px 0 15px rgba(255, 255, 255, 0.1);
        }
        
        .vip-locked { color: #555; position: relative; }
        .vip-locked::after { content: '🔒'; position: absolute; left: 20px; opacity: 0.5; }

        /* المحتوى الرئيسي */
        .main-content { flex: 1; padding: 40px; overflow-y: auto; position: relative; }
        .tab-content { display: none; }
        .tab-content.active { display: block; animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        /* البطاقات */
        .card { 
            background: linear-gradient(145deg, #0f0f0f, #070707); border: 1px solid #222; 
            border-radius: 12px; padding: 30px; max-width: 650px; margin: 0 auto; width: 100%; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.8);
        }
        .card h2 { margin-bottom: 20px; font-size: 22px; border-bottom: 1px solid #222; padding-bottom: 15px; color: #fff; font-weight: 900; }
        .card p.desc { color: #aaa; font-size: 14px; margin-bottom: 20px; }
        
        .input-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 8px; font-size: 14px; color: #aaa; font-weight: 700; }
        
        input[type="text"], input[type="password"], input[type="number"] { 
            width: 100%; padding: 15px; background-color: #000; border: 1px solid #333; 
            color: #fff; border-radius: 8px; outline: none; transition: all 0.3s ease; font-size: 16px;
        }
        input:focus { border-color: #fff; box-shadow: 0 0 15px rgba(255,255,255,0.15); background-color: #0a0a0a; }
        
        .checkbox-group { display: flex; align-items: center; gap: 12px; margin-bottom: 15px; cursor: pointer; }
        .checkbox-group input { width: 22px; height: 22px; accent-color: #fff; cursor: pointer; }
        .checkbox-group label { margin-bottom: 0; cursor: pointer; color: #ddd; font-size: 16px; }

        button { 
            width: 100%; padding: 16px; background-color: #fff; color: #000; border: 2px solid #fff; 
            border-radius: 8px; font-weight: 900; cursor: pointer; transition: all 0.3s ease; 
            margin-top: 10px; font-size: 16px; letter-spacing: 1px;
        }
        button:hover { background-color: transparent; color: #fff; box-shadow: 0 0 20px rgba(255,255,255,0.3); }

        /* الكونسول */
        .console { 
            background-color: #000; border: 1px solid #222; border-radius: 8px; padding: 15px; 
            height: 200px; overflow-y: auto; margin-top: 25px; font-family: monospace; 
            font-size: 14px; direction: ltr; text-align: left; box-shadow: inset 0 0 20px rgba(0,0,0,1);
        }
        .console p { margin-bottom: 8px; color: #666; border-left: 2px solid #333; padding-left: 10px; }
        .console p.success { color: #fff; border-color: #fff; }
        .console p.error { color: #ff3333; border-color: #ff3333; }
        
        .token-status { font-size: 14px; margin-top: 5px; color: #aaa; font-weight: bold; }

        /* التصميم المتجاوب للجوال */
        @media (max-width: 768px) {
            body { flex-direction: column; height: auto; overflow-y: auto; }
            .sidebar { width: 100%; flex-direction: row; overflow-x: auto; white-space: nowrap; padding: 10px; border-left: none; border-bottom: 1px solid #222; height: auto; }
            .logo { display: none; } 
            .nav-item { padding: 12px 15px; border-right: none; border-bottom: 3px solid transparent; font-size: 14px; }
            .nav-item:hover { padding-right: 15px; }
            .nav-item.active { border-right: none; border-bottom: 3px solid #fff; box-shadow: 0 5px 15px rgba(255, 255, 255, 0.1); }
            .vip-locked::after { left: 5px; top: 5px; font-size: 12px; }
            .main-content { padding: 20px 15px; height: auto; overflow: visible; }
            .card { padding: 20px; margin-bottom: 20px; }
        }
    </style>
</head>
<body>

    <!-- القائمة الجانبية -->
    <div class="sidebar">
        <div class="logo">LRZ Panel</div>
        <div class="nav-item active" onclick="switchTab('nuke', this)">نيوك</div>
        <div class="nav-item" onclick="switchTab('massspam', this)">سبام رسائل</div>
        <div class="nav-item" onclick="switchTab('webhook', this)">سبام ويب هوك</div>
        <div class="nav-item" onclick="switchTab('report', this)">سبام بلاغات</div>
        <div class="nav-item" onclick="switchTab('banuser', this)">باند شخص</div>
        <div class="nav-item" onclick="switchTab('nukeuser', this)">تدمير حساب</div>
        <div class="nav-item" onclick="switchTab('clone', this)">نسخ سيرفر</div>
        <div class="nav-item" onclick="switchTab('2fa', this)">مولد 2FA</div>
        <div class="nav-item" onclick="switchTab('scanner', this)">فحص الملفات</div>
        <div class="nav-item" onclick="switchTab('admin', this)">لوحة الإدارة</div>
        <div class="nav-item vip-locked" id="vipTabNav" onclick="switchTab('vip', this)">أدوات VIP</div>
    </div>

    <!-- المحتوى الرئيسي -->
    <div class="main-content">
        
        <!-- قسم النيوك -->
        <div id="nuke" class="tab-content active">
            <div class="card">
                <h2>نيوك السيرفر</h2>
                <p class="desc">تدمير شامل للسيرفر: حظر الجميع، تغيير الأسماء، حذف الرومات والرتب، وإنشاء رومات سبام.</p>
                <div class="input-group">
