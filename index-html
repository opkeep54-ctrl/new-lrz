                <div class="input-group"><label>الاسم الجديد للسيرفر (اختياري)</label><input type="text" id="nuke-name" placeholder="New Name"></div>
                <div class="input-group"><label>تغيير اسم الأعضاء إلى (اختياري)</label><input type="text" id="nuke-nickname" placeholder="مثال: تم تدميرك"></div>
                <div class="input-group"><label>عدد الرومات (أقصى حد 100)</label><input type="number" id="nuke-channels" value="50" max="100"></div>
                <div class="input-group"><label>رسالة السبام</label><input type="text" id="nuke-msg" value="@everyone NUKED BY LRZ"></div>
