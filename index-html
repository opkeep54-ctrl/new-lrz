                <div class="input-group">
                    <label>توكن بشري (User Token)</label>
                    <input type="password" id="report-token" placeholder="User Token..." oninput="validateToken('report')">
                    <div class="token-status" id="report-status"></div>
                </div>
                <div class="input-group"><label>ID السيرفر</label><input type="text" id="report-guild" placeholder="Guild ID"></div>
                <div class="input-group"><label>ID الشخص أو السيرفر المراد التبليغ عنه</label><input type="text" id="report-user" placeholder="User/Guild ID"></div>
                <div class="input-group"><label>السبب</label><input type="text" id="report-reason" value="Scam / Raid / Illegal Activities"></div>
                <div class="input-group"><label>عدد البلاغات</label><input type="number" id="report-amount" value="50"></div>
                <button onclick="sendAction('report', 'report_spam')">إرسال البلاغات</button>
            </div>
        </div>

        <!-- قسم باند شخص -->
        <div id="banuser" class="tab-content">
            <div class="card">
                <h2>باند شخص من السيرفر</h2>
                <p class="desc">حظر شخص معين من سيرفر تملك فيه صلاحيات.</p>
                <div class="input-group">
                    <label>توكن البوت (Bot Token)</label>
                    <input type="password" id="banuser-token" placeholder="ضع توكن البوت هنا..." oninput="validateToken('banuser')">
                    <div class="token-status" id="banuser-status"></div>
