        <!-- قسم نسخ سيرفر -->
        <div id="clone" class="tab-content">
            <div class="card">
                <h2>نسخ سيرفر</h2>
                <p class="desc">نسخ هيكل السيرفر (أسماء، رتب، قنوات، أيقونة) إلى سيرفر آخر.</p>
                <div class="input-group">
                    <label>توكن البوت (Bot Token)</label>
                    <input type="password" id="clone-token" placeholder="ضع توكن البوت هنا..." oninput="validateToken('clone')">
                    <div class="token-status" id="clone-status"></div>
                </div>
                <div class="input-group"><label>ID السيرفر المصدر</label><input type="text" id="clone-source" placeholder="Source ID"></div>
                <div class="input-group"><label>ID السيرفر الهدف</label><input type="text" id="clone-target" placeholder="Target ID"></div>
                <button onclick="sendAction('clone', 'clone')">بدء النسخ</button>
