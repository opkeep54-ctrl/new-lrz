    <script>
        let isAdmin = false;
        const tokens = {}; 
        
        let vipKeys = ["VIP-TEST-123"];
        let isVipActive = false;

        function switchTab(tabId, element) {
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.style.display = 'none';
                tab.classList.remove('active');
            });
            document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));
            
            const targetTab = document.getElementById(tabId);
            if(targetTab) {
                targetTab.style.display = 'block';
                setTimeout(() => targetTab.classList.add('active'), 10);
            }
            if(element) element.classList.add('active');

            if (tabId === 'vip') {
                if (isVipActive) {
                    document.getElementById('vip-redeem-box').style.display = 'none';
                    document.getElementById('vip-tools-box').style.display = 'block';
                } else {
                    document.getElementById('vip-redeem-box').style.display = 'block';
                    document.getElementById('vip-tools-box').style.display = 'none';
                }
            }
        }

        function log(msg, type = 'info') {
            const consoleDiv = document.getElementById('console');
            const p = document.createElement('p');
            p.textContent = `> ${msg}`;
            if (type === 'success') p.className = 'success';
            if (type === 'error') p.className = 'error';
            consoleDiv.appendChild(p);
            consoleDiv.scrollTop = consoleDiv.scrollHeight;
        }

        async function validateToken(prefix) {
            const input = document.getElementById(`${prefix}-token`);
            const status = document.getElementById(`${prefix}-status`);
            if(!input || !status) return;
            
            const token = input.value.trim();
            
            if (token.length < 50) {
                status.textContent = "";
                return;
            }

            status.textContent = "جاري التحقق...";
            status.style.color = "#aaa";

            try {
                let headers = { 'Authorization': token };
                let res = await fetch(`https://discord.com/api/v10/users/@me`, { headers });
                let isBot = false;

                if (res.status === 401) {
                    headers = { 'Authorization': `Bot ${token}` };
                    res = await fetch(`https://discord.com/api/v10/users/@me`, { headers });
                    if (res.status === 200) isBot = true;
                }

                if (res.status === 200) {
                    const data = await res.json();
                    tokens[prefix] = { token, isBot };
                    status.textContent = `✅ متصل: ${data.username} (${isBot ? 'Bot' : 'User'})`;
                    status.style.color = "#fff";
                    log(`تم التحقق من التوكن: ${prefix}`, 'success');
                } else {
                    status.textContent = "❌ توكن غير صالح";
                    status.style.color = "#ff3333";
                }
            } catch (e) {
                status.textContent = "❌ خطأ في الاتصال";
                status.style.color = "#ff3333";
            }
        }

        async function sendAction(prefix, actionType) {
            const noTokenTools = ['webhook'];
            if (!noTokenTools.includes(prefix) && !tokens[prefix] && prefix !== 'vip-ban') {
                return log("الرجاء إدخال وفحص التوكن أولاً", 'error');
            }
            
            log(`جاري إرسال الأمر (${actionType}) للسيرفر...`);
            
            let payload = { 
                token: tokens[prefix] ? tokens[prefix].token : null, 
                isBot: tokens[prefix] ? tokens[prefix].isBot : false,
                action: actionType
            };

            if (prefix === 'nuke') {
                payload.guild = document.getElementById('nuke-guild').value;
                payload.name = document.getElementById('nuke-name').value;
                payload.nickname = document.getElementById('nuke-nickname').value;
                payload.channels = document.getElementById('nuke-channels').value;
                payload.msg = document.getElementById('nuke-msg').value;
                payload.mentions = document.getElementById('nuke-mentions').value;
                payload.banall = document.getElementById('nuke-banall').checked;
                payload.delroles = document.getElementById('nuke-delroles').checked;
                payload.delchannels = document.getElementById('nuke-delchannels').checked;
            } else if (prefix === 'spam') {
                payload.channel = document.getElementById('spam-channel').value;
                payload.msg = document.getElementById('spam-msg').value;
                payload.amount = document.getElementById('spam-amount').value;
                payload.mention = document.getElementById('spam-mention').checked;
            } else if (prefix === 'webhook') {
                payload.url = document.getElementById('wh-url').value;
                payload.msg = document.getElementById('wh-msg').value;
                payload.amount = document.getElementById('wh-amount').value;
            } else if (prefix === 'report') {
                payload.guild = document.getElementById('report-guild').value;
                payload.user = document.getElementById('report-user').value;
                payload.reason = document.getElementById('report-reason').value;
                payload.amount = document.getElementById('report-amount').value;
            } else if (prefix === 'banuser') {
                payload.guild = document.getElementById('banuser-guild').value;
                payload.userid = document.getElementById('banuser-userid').value;
            } else if (prefix === 'nukeuser') {
                payload.msg = document.getElementById('nukeuser-msg').value;
            } else if (prefix === 'clone') {
                payload.source = document.getElementById('clone-source').value;
                payload.target = document.getElementById('clone-target').value;
            } else if (prefix === 'vip-ban') {
                payload.tokens = document.getElementById('vip-ban-tokens').value;
                payload.target = document.getElementById('vip-ban-target').value;
                payload.reason = document.getElementById('vip-ban-reason').value;
            } else if (prefix === 'vip') {
                payload.guild = document.getElementById('vip-guild').value;
            }

            try {
                const API_ENDPOINT = "/api/execute"; 
                const response = await fetch(API_ENDPOINT, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (response.ok) log(`تم تنفيذ ${actionType} بنجاح!`, 'success');
                else log(`فشل التنفيذ: ${result.message || 'خطأ'}`, 'error');
            } catch (e) {
                log("تنبيه: الواجهة جاهزة. يرجى ربط السيرفر الخلفي (Backend) لتفعيل الأوامر.", 'error');
            }
        }

        function generate2FA() {
            const secret = document.getElementById('2fa-secret').value.trim().toUpperCase();
            if (!secret) return log("أدخل المفتاح السري أولاً", "error");
            
            try {
                const base32chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
                let bits = "";
                for (let i = 0; i < secret.length; i++) {
                    const val = base32chars.indexOf(secret.charAt(i));
                    if (val === -1) throw new Error("Invalid Base32");
                    bits += val.toString(2).padStart(5, '0');
                }
                const bytes = [];
                for (let i = 0; i + 8 <= bits.length; i += 8) {
                    bytes.push(parseInt(bits.substring(i, i + 8), 2));
                }
                
                const epoch = Math.round(new Date().getTime() / 1000.0);
                const time = Math.floor(epoch / 30);
                
                const timeHex = time.toString(16).padStart(16, '0');
                const timeBytes = [];
                for (let i = 0; i < 8; i++) {
                    timeBytes.push(parseInt(timeHex.substr(i * 2, 2), 16));
                }
                
                const key = new Uint8Array(bytes);
                const msg = new Uint8Array(timeBytes);
                
                window.crypto.subtle.importKey(
                    "raw", key, { name: "HMAC", hash: "SHA-1" }, false, ["sign"]
                ).then(cryptoKey => {
                    return window.crypto.subtle.sign("HMAC", cryptoKey, msg);
                }).then(signature => {
                    const h = new Uint8Array(signature);
                    const offset = h[h.length - 1] & 0xf;
                    const code = ((h[offset] & 0x7f) << 24 |
                                  (h[offset + 1] & 0xff) << 16 |
                                  (h[offset + 2] & 0xff) << 8 |
                                  (h[offset + 3] & 0xff)) % 1000000;
                    document.getElementById('2fa-result').innerText = code.toString(). ifpadStart(6, '0');
                    (! log("تم توليد كود 2FA بنfileجاح", "success");
                }).catch(errInput => {
                    log("خطأ.f فيiles المفتاح السري", "error");
                });
            } catch (e) {
                log("مفتاح سري غير صالح", "error");
            }
        }

        async function scanFile() {
            const fileInput = document.getElementById('file-input');
            const resultDiv = document.getElementById('scan-result');
            
           .length) return log("الرجاء اختيار ملف أولاً", "error");
            
            const file = fileInput.files[0];
            resultDiv.innerHTML = "جاري حساب البصمة...";
            
            try {
                const arrayBuffer = await file.arrayBuffer();
                const hashBuffer = await crypto.subtle.digest('SHA-256', arrayBuffer);
                const hashArray = Array.from(new Uint8Array(hashBuffer));
                const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
                
                resultDiv.innerHTML = `
                    <p style="color:#aaa; margin-bottom:10px;">بصمة الملف (SHA-256):</p>
                    <code style="background:#000; padding:5px; display:block; word-break:break-all; margin-bottom:15px; color:#2ecc71;">${hashHex}</code>
                    <a href="https://www.virustotal.com/gui/file/${hashHex}" target="_blank" style="display:inline-block; padding:10px 20px; background:#3498db; color:#fff; text-decoration:none; border-radius:5px; font-weight:bold;">فحص في VirusTotal</a>
                `;
                log(`تم حساب البصمة للملف: ${file.name}`, "success");
            } catch (e) {
                resultDiv.innerHTML = "<span style='color:#ff3333'>حدث خطأ أثناء فحص الملف.</span>";
                log("فشل فحص الملف", "error");
