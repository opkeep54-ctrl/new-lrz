                <div class="input-group"><label>ID الروم</label><input type="text" id="spam-channel" placeholder="Channel ID"></div>
                <div class="input-group"><label>الرسالة</label><input type="text" id="spam-msg" placeholder="الرسالة"></div>
                <div class="input-group"><label>عدد الرسائل</label><input type="number" id="spam-amount" value="10"></div>
                <div class="checkbox-group"><input type="checkbox" id="spam-mention"><label>منشن @everyone</label></div>
                <button onclick="sendAction('spam', 'mass_spam')">بدء السبام</button>
            </div>
        </div>

        <!-- قسم سبام ويب هوك -->
        <div id="webhook" class="tab-content">
            <div class="card">
                <h2>سبام ويب هوك</h2>
