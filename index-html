                </div>
                <button onclick="generate2FA()">توليد الكود</button>
                <div id="2fa-result" style="margin-top:20px; font-size:24px; text-align:center; font-weight:bold; color:#2ecc71; letter-spacing:5px;"></div>
            </div>
        </div>

        <!-- قسم فحص الملفات -->
        <div id="scanner" class="tab-content">
            <div class="card">
                <h2>فحص الملفات (Malware Scanner)</h2>
                <p class="desc">ارفع أي ملف لاستخراج بصمته (SHA-256) وفحصه عبر قاعدة بيانات VirusTotal لمعرفة إذا كان ملغماً.</p>
                <div class="input-group">
                    <label>اختر الملف (يدعم أي صيغة)</label>
                    <input type="file" id="file-input" style="padding:10px; background:#111; border:1px solid #333;">
                </div>
                <button onclick="scanFile()">فحص الملف</button>
                <div id="scan-result" style="margin-top:20px; text-align:center; font-size:16px;"></div>
            </div>
        </div>

        <!-- قسم لوحة الإدارة -->
        <div id="admin" class="tab-content">
            <div class="card">
                <h2>لوحة الإدارة</h2>
                <div class="input-group"><label>مفتاح الإدارة</label><input type="password" id="admin-key" placeholder="Admin Key"></div>
                <button onclick="checkAdmin()">دخول</button>
                
                <div id="admin-actions" style="display:none; margin-top:20px;">
                    <button onclick="generateVipKey()" style="background-color:#3498db; border-color:#3498db; color:#fff;">توليد مفتاح VIP</button>
                    <div id="generated-keys" style="margin-top:15px; font-family:monospace; color:#2ecc71; font-size:16px;"></div>
                </div>
            </div>
        </div>

        <!-- قسم VIP -->
        <div id="vip" class="tab-content">
            <div id="vip-redeem-box" class="card">
                <h2>تفعيل VIP</h2>
                <p class="desc">أدخل مفتاح التفعيل للوصول لأدوات VIP.</p>
                <div class="input-group"><label>مفتاح VIP</label><input type="text" id="redeem-key" placeholder="VIP-XXXXX"></div>
                <button onclick="redeemVip()">تفعيل</button>
            </div>

            <!-- أدوات VIP بعد التفعيل -->
            <div id="vip-tools-box" class="card" style="display:none;">
                <h2>أدوات VIP</h2>
                
                <!-- أداة تبنيد حساب -->
                <div style="background:#111; padding:20px; border-radius:8px; border:1px solid #333; margin-bottom:20px;">
                    <h3 style="margin-bottom:10px; color:#e74c3c;">تبنيد حساب دسكورد (Account Ban)</h3>
                    <p class="desc">إرسال بلاغات ضخمة من توكنات بشرية متعددة لتبنيد حساب شخص نهائياً.</p>
                    <div class="input-group">
                        <label>توكنات البشر (User Tokens - سطر لكل توكن)</label>
                        <textarea id="vip-ban-tokens" placeholder="توكن 1&#10;توكن 2..." style="width:100%; height:80px; padding:10px; background:#000; color:#fff; border:1px solid #333; border-radius:8px; font-family:monospace;"></textarea>
                    </div>
                    <div class="input-group"><label>ID الحساب المراد تبنيده</label><input type="text" id="vip-ban-target" placeholder="User ID"></div>
                    <div class="input-group"><label>السبب</label><input type="text" id="vip-ban-reason" value="Child Abuse / Terrorism"></div>
                    <button onclick="sendAction('vip-ban', 'account_ban')">بدء التبنيد</button>
                </div>

                <div style="background:#111; padding:20px; border-radius:8px; border:1px solid #333;">
                    <h3 style="margin-bottom:10px; color:#e74c3c;">باند الجميع (VIP Ban All)</h3>
                    <div class="input-group">
                        <label>توكن البوت (Bot Token)</label>
                        <input type="password" id="vip-token" placeholder="ضع توكن البوت هنا..." oninput="validateToken('vip')">
                        <div class="token-status" id="vip-status"></div>
                    </div>
                    <div class="input-group"><label>ID السيرفر</label><input type="text" id="vip-guild" placeholder="Guild ID"></div>
                    <button onclick="sendAction('vip', 'banall')">تنفيذ باند VIP</button>
                </div>
            </div>
        </div>

        <!-- الكونسول -->
        <div class="console" id="console">
            <p>[System] Waiting for input...</p>
        </div>
