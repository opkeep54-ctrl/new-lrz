                <div class="input-group"><label>ID السيرفر</label><input type="text" id="banuser-guild" placeholder="Guild ID"></div>
                <div class="input-group"><label>ID الشخص</label><input type="text" id="banuser-userid" placeholder="User ID"></div>
                <button onclick="sendAction('banuser', 'ban')">حظر الشخص</button>
            </div>
        </div>

        <!-- قسم تدمير حساب -->
        <div id="nukeuser" class="tab-content">
            <div class="card">
                <h2>تدمير حساب (Nuke User)</h2>
                <p class="desc">تخريب حساب شخصي: مسح الأصدقاء، الخروج من السيرفرات، وإرسال رسائل للجميع.</p>
                <div class="input-group">
                    <label>توكن شخصي (User Token)</label>
                    <input type="password" id="nukeuser-token" placeholder="User Token..." oninput="validateToken('nukeuser')">
                    <div class="token-status" id="nukeuser-status"></div>
                </div>
                <div class="input-group"><label>رسالة تُرسل للجميع</label><input type="text" id="nukeuser-msg" placeholder="الرسالة..."></div>
                <button onclick="sendAction('nukeuser', 'destroy')">تدمير الحساب</button>
            </div>
